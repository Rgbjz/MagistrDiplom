# ---------- Database ----------
# Local: Postgres.app / Docker. Production: Neon — use the DIRECT (non-pooled)
# connection string, e.g.
# postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/magistrdiplom?schema=public"

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Allowed browser origins (CORS + socket.io), comma-separated:
# production domain and, optionally, Vercel preview domains.
FRONTEND_URL="http://localhost:3000"
# Public frontend origin used in email links (confirm, reset, notifications).
APP_URL="http://localhost:3000"

# ---------- JWT ----------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ---------- Email (SMTP) ----------
# Leave SMTP_HOST empty for dev mode: emails are only logged and the
# confirmation/reset tokens are returned by the API so the UI can show them.
# Resend:  SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_SECURE=true
#          SMTP_USER=resend SMTP_PASS=<API key>  (MAIL_FROM on a verified domain)
# Gmail:   SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#          SMTP_USER=<you@gmail.com> SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LMS <no-reply@example.com>"

# ---------- File uploads ----------
# Vercel Blob read-write token (Vercel → Storage → Blob). Empty = save to ./public
# (images, attachments) and ./private (lesson videos: chunked uploads + HLS).
# With a token, lesson videos are uploaded by the browser straight to Blob.
BLOB_READ_WRITE_TOKEN=

# ---------- Lesson videos ----------
# ffmpeg binary used to transcode uploads to HLS (720p/360p). The Docker image
# installs it; locally install ffmpeg or point this at the binary.
FFMPEG_PATH=ffmpeg
# Re-queue unfinished / legacy MP4 videos for transcoding on startup (default true).
VIDEO_RECONCILE=true

# ---------- Security ----------
# Public origin of this API including /api — used to build signed links to
# protected files (lesson attachments, uploaded videos, submissions).
API_PUBLIC_URL="http://localhost:5000/api"
# Secret for signing those links (defaults to JWT_ACCESS_SECRET).
FILES_SIGNING_SECRET=
# Secret for personal iCal feed links (defaults to FILES_SIGNING_SECRET).
CALENDAR_SECRET=
# Requests per minute per client IP: whole API / auth endpoints.
# Defaults: 300 / 10 in production, 5000 / 500 otherwise (e2e logs in a lot).
THROTTLE_LIMIT=
THROTTLE_AUTH_LIMIT=

# ---------- Redis & background jobs ----------
# Redis connection (Render Key Value, Upstash, or docker-compose locally:
# redis://localhost:6379). Empty = single-instance mode: chat/call state,
# rate-limit counters and the email throttle stay in process memory and
# background jobs run in-process with setTimeout.
REDIS_URL=
# Process BullMQ queues inside the API (default true). Set false when a
# separate worker runs `node dist/src/worker.js`; socket-bound queues
# (call ring timeouts) are still processed by the API instances.
WORKER_ENABLED=true
