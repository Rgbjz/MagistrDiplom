generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  REJECTED
  COMPLETED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
  SHORT_TEXT
  NUMERIC
  MATCHING
  ORDERING
  ESSAY
}

// When students may see the correct answers on the result page.
enum ShowAnswersMode {
  NEVER
  AFTER_SUBMIT
  AFTER_PASS
  AFTER_CLOSE
}

enum AttemptQuestionStatus {
  AUTO
  PENDING
  GRADED
}

enum ConversationType {
  COURSE
  DIRECT
  GROUP
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NotificationType {
  ENROLLMENT_REQUEST
  ENROLLMENT_APPROVED
  ENROLLMENT_REJECTED
  NEW_LESSON
  TEST_RESULT
  NEW_MESSAGE
  PAYMENT
  CERTIFICATE
  ASSIGNMENT_SUBMITTED
  ASSIGNMENT_GRADED
  COURSE_STAFF_ADDED
  DEADLINE_REMINDER
  GRADE_UPDATED
}

// How the final percent is presented: plain %, Ukrainian 5-point, ECTS letters or pass/fail.
enum GradingScale {
  PERCENT
  FIVE_POINT
  ECTS
  PASS_FAIL
}

// Course team. OWNER mirrors Course.teacherId (kept for compatibility).
enum CourseStaffRole {
  OWNER
  TEACHER
  ASSISTANT
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

// ===== Core =====
model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  role              UserRole  @default(STUDENT)
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  blocked           Boolean   @default(false)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  profile              UserProfile?
  sessions             Session[]
  courses              Course[]                  @relation("TeacherCourses")
  enrollments          Enrollment[]
  lessonProgresses     LessonProgress[]
  testResults          TestResult[]
  userAnswers          UserAnswer[]
  messages             Message[]
  participations       ConversationParticipant[]
  payments             Payment[]
  notifications        Notification[]
  certificates         Certificate[]
  submissions          Submission[]
  staffships           CourseStaff[]
  courseEvents         CourseEvent[]             @relation("CourseEventAuthor")
  gradeOverrides       GradeOverride[]
  gradeOverrideHistory GradeOverrideHistory[]
  sectionMasteries     LearnerSectionMastery[]
  abilities            LearnerAbility[]
  adaptiveEvents       AdaptiveEvent[]
}

model UserProfile {
  id                   Int      @id @default(autoincrement())
  firstName            String?
  lastName             String?
  avatarUrl            String?
  bio                  String?
  emailNotifications   Boolean  @default(true)
  /// Interface/email language: uk | en | pl
  locale               String   @default("uk")
  /// Deadline reminders (in-app + email) — calendar feature
  deadlineReminders    Boolean  @default(true)
  /// Bumped to revoke the personal iCal feed URL
  calendarTokenVersion Int      @default(0)
  userId               Int      @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id                   Int      @id @default(autoincrement())
  userId               Int
  refreshTokenHash     String
  // Token replaced by the last rotation; still accepted (without another
  // rotation) so parallel refreshes from one browser don't kill the session.
  prevRefreshTokenHash String?
  userAgent            String?
  ip                   String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                 Int          @id @default(autoincrement())
  title              String
  description        String?
  imageUrl           String?
  price              Int          @default(0)
  category           String?
  level              CourseLevel?
  published          Boolean      @default(false)
  autoApprove        Boolean      @default(false)
  // Gradebook: category weights (sum 100) and the final-grade pass mark, %.
  testsWeight        Int          @default(50)
  assignmentsWeight  Int          @default(50)
  gradePassThreshold Int          @default(60)
  gradingScale       GradingScale @default(PERCENT)
  // Custom thresholds for FIVE_POINT / ECTS: [{ code, min }] in descending order.
  gradingScaleConfig Json?
  teacherId          Int
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  teacher              User                    @relation("TeacherCourses", fields: [teacherId], references: [id])
  sections             Section[]
  enrollments          Enrollment[]
  conversations        Conversation[]
  payments             Payment[]
  certificates         Certificate[]
  staff                CourseStaff[]
  questionBank         QuestionBankCategory[]
  events               CourseEvent[]
  gradeOverrides       GradeOverride[]
  gradeOverrideHistory GradeOverrideHistory[]
  adaptiveSettings     CourseAdaptiveSettings?
  sectionMasteries     LearnerSectionMastery[]
  abilities            LearnerAbility[]
  adaptiveEvents       AdaptiveEvent[]
}

model CourseStaff {
  id        Int             @id @default(autoincrement())
  courseId  Int
  userId    Int
  role      CourseStaffRole
  createdAt DateTime        @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model Section {
  id        Int      @id @default(autoincrement())
  title     String
  order     Int
  courseId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  masteries LearnerSectionMastery[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  videoUrl  String?
  order     Int
  sectionId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section    Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progresses LessonProgress[]
  test       Test?
  files      LessonFile[]
  assignment Assignment?
  video      LessonVideo?
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

// Video uploaded for a lesson (YouTube/Vimeo links stay in Lesson.videoUrl).
// The source is transcoded to HLS renditions by the background "video" queue.
model LessonVideo {
  id          Int         @id @default(autoincrement())
  lessonId    Int         @unique
  status      VideoStatus @default(UPLOADING)
  progress    Int         @default(0)
  // Uploaded original: /private/... path (local) or a Vercel Blob URL.
  sourceUrl   String?
  // Progressive MP4 served when HLS is unavailable (legacy uploads, mp4 sources).
  mp4Url      String?
  // HLS output folder: "hls/<id>-<rand>" (local) or a Blob base URL ending with "/".
  hlsPrefix   String?
  renditions  String?
  hasPoster   Boolean     @default(false)
  durationSec Float?
  width       Int?
  height      Int?
  sizeBytes   Int?
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// Practical task attached to a lesson; students hand in files.
model Assignment {
  id          Int       @id @default(autoincrement())
  lessonId    Int       @unique
  title       String
  description String?
  dueAt       DateTime?
  maxScore    Int       @default(100)
  maxFiles    Int       @default(5)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

// A student's current hand-in for an assignment (resubmission replaces files).
model Submission {
  id           Int              @id @default(autoincrement())
  assignmentId Int
  userId       Int
  comment      String?
  status       SubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  late         Boolean          @default(false)

  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  files      SubmissionFile[]

  @@unique([assignmentId, userId])
}

model SubmissionFile {
  id           Int      @id @default(autoincrement())
  submissionId Int
  name         String
  url          String
  size         Int
  mimeType     String
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// Attachment a teacher uploads to a lesson (slides, PDFs, archives…).
model LessonFile {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  name      String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Test {
  id                  Int             @id @default(autoincrement())
  lessonId            Int             @unique
  title               String          @default("Test")
  timeLimit           Int
  passingScore        Int             @default(60)
  shuffleQuestions    Boolean         @default(false)
  shuffleAnswers      Boolean         @default(false)
  maxAttempts         Int?
  questionsPerAttempt Int?
  showCorrectAnswers  ShowAnswersMode @default(AFTER_SUBMIT)
  // Adaptive question selection at attempt start; null = course default.
  adaptive            Boolean?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   Question[]
  results     TestResult[]
  randomRules TestRandomRule[]
}

// A question belongs either to a test (testId) or to the course question bank (categoryId).
model Question {
  id                   Int          @id @default(autoincrement())
  testId               Int?
  categoryId           Int?
  text                 String
  type                 QuestionType @default(SINGLE)
  difficulty           Int          @default(1)
  points               Int          @default(1)
  partialCredit        Boolean      @default(false)
  // Online-calibrated difficulty b on the logit (Rasch/Elo) scale; null until
  // the first graded answer (then initialised from `difficulty`).
  calibratedDifficulty Float?
  calibrationCount     Int          @default(0)
  // Type-specific settings: accepted answers, numeric value/tolerance, matching pairs, ordering items, essay limits.
  config               Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  test             Test?                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  category         QuestionBankCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  answers          Answer[]
  userAnswers      UserAnswer[]
  attemptQuestions AttemptQuestion[]

  @@index([categoryId])
}

model QuestionBankCategory {
  id        Int      @id @default(autoincrement())
  courseId  Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions Question[]
  rules     TestRandomRule[]

  @@index([courseId])
}

// «N random questions from bank category X» added to every attempt of a test.
model TestRandomRule {
  id         Int @id @default(autoincrement())
  testId     Int
  categoryId Int
  count      Int

  test     Test                 @relation(fields: [testId], references: [id], onDelete: Cascade)
  category QuestionBankCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([testId, categoryId])
}

// A question as drawn for one attempt: order, shuffled options, response and points.
model AttemptQuestion {
  id           Int                   @id @default(autoincrement())
  testResultId Int
  questionId   Int
  position     Int
  // Option order shown to the student (answer ids, matching right indexes or ordering item indexes).
  optionOrder  Json?
  response     Json?
  earned       Float                 @default(0)
  maxPoints    Int
  status       AttemptQuestionStatus @default(AUTO)
  feedback     String?
  gradedAt     DateTime?
  gradedById   Int?

  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testResultId, questionId])
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]
}

model Enrollment {
  id            Int              @id @default(autoincrement())
  userId        Int
  courseId      Int
  status        EnrollmentStatus @default(PENDING)
  enrolledAt    DateTime         @default(now())
  completedAt   DateTime?
  // A/B experiment arm (null while the course runs no experiment).
  adaptiveGroup AdaptiveGroup?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  // Students of a course (the unique key starts with userId).
  @@index([courseId, status])
}

model LessonProgress {
  id          Int                  @id @default(autoincrement())
  userId      Int
  lessonId    Int
  status      LessonProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  // Progress of a course's lessons across students (analytics).
  @@index([lessonId])
}

model TestResult {
  id               Int       @id @default(autoincrement())
  userId           Int
  testId           Int
  attempt          Int
  startedAt        DateTime
  finishedAt       DateTime?
  score            Int?
  passed           Boolean?
  // An essay answer awaits manual grading; score is provisional and passed is null.
  pendingReview    Boolean   @default(false)
  // How the questions were chosen: FIXED (usual draw) or ADAPTIVE (by ability).
  strategy         String?
  targetDifficulty Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  test      Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers   UserAnswer[]
  questions AttemptQuestion[]

  // Attempts of a test / of one student in a test (gradebook, analytics,
  // adaptive model); without it these were sequential scans.
  @@index([testId, userId])
}

model UserAnswer {
  id           Int      @id @default(autoincrement())
  userId       Int
  questionId   Int
  answerId     Int
  testResultId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     Answer     @relation(fields: [answerId], references: [id], onDelete: Cascade)
  testResult TestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
}

// ===== Chat =====
model Conversation {
  id        Int              @id @default(autoincrement())
  type      ConversationType
  courseId  Int?
  /// GROUP only: name shown in the chat list and the owner who manages members.
  title     String?
  ownerId   Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  course       Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int      @id @default(autoincrement())
  conversationId Int
  userId         Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Chat history page: newest messages of a conversation.
  @@index([conversationId, createdAt])
}

model Payment {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  amount    Int
  status    String   @default("PAID")
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Certificate {
  id       Int      @id @default(autoincrement())
  code     String   @unique
  userId   Int
  courseId Int
  avgScore Int?
  issuedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ===== Calendar =====
enum CourseEventKind {
  LECTURE
  ONLINE_LESSON
  DEADLINE
  OTHER
}

// A dated event a course team adds to the calendar (lecture, online lesson…).
model CourseEvent {
  id          Int             @id @default(autoincrement())
  courseId    Int
  title       String
  description String?
  kind        CourseEventKind @default(OTHER)
  startsAt    DateTime
  endsAt      DateTime?
  createdById Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("CourseEventAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([courseId, startsAt])
}

// Manual gradebook correction by course staff. itemKey: 'test-<id>' | 'assignment-<id>' | 'final'.
// value is a percent for tests and the final grade, points for assignments.
model GradeOverride {
  id          Int      @id @default(autoincrement())
  courseId    Int
  userId      Int
  itemKey     String
  value       Float
  reason      String
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, itemKey])
}

// Audit trail: every set / change / reset of an override.
model GradeOverrideHistory {
  id          Int      @id @default(autoincrement())
  courseId    Int
  userId      Int
  itemKey     String
  oldValue    Float?
  newValue    Float?
  reason      String
  changedById Int
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, userId])
}

// ===== Adaptive learning =====

enum AdaptiveExperimentMode {
  OFF
  AB_TEST
}

enum AdaptiveGroup {
  ADAPTIVE
  CONTROL
}

enum AdaptiveEventType {
  RECOMMENDATION_SHOWN
  RECOMMENDATION_OPENED
  MASTERY_UPDATED
  ADAPTIVE_TEST_GENERATED
}

// Per-course switches and thresholds of the adaptation module.
model CourseAdaptiveSettings {
  courseId              Int                    @id
  enabled               Boolean                @default(true)
  masteryThreshold      Float                  @default(0.6)
  accelerationThreshold Float                  @default(0.85)
  adaptiveTestsDefault  Boolean                @default(false)
  experimentMode        AdaptiveExperimentMode @default(OFF)
  experimentStartedAt   DateTime?
  updatedAt             DateTime               @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// Learner model: mastery m ∈ [0,1] of one course section (topic).
model LearnerSectionMastery {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  sectionId Int
  mastery   Float    @default(0.5)
  evidence  Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
  @@index([courseId])
}

// Learner model: ability θ on the logit scale within one course.
model LearnerAbility {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  theta     Float    @default(0)
  answers   Int      @default(0)
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// Log of the adaptation module (recommendations shown/opened, model updates).
model AdaptiveEvent {
  id        Int               @id @default(autoincrement())
  userId    Int
  courseId  Int
  type      AdaptiveEventType
  key       String?
  payload   Json?
  createdAt DateTime          @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, type])
  @@index([userId, courseId, type])
}
