# ===== Local development =====
# Copy to .env.local. On Vercel set the same variables in
# Project Settings → Environment Variables (Production + Preview).

# Backend API, including the /api prefix.
#   local:      http://localhost:5000/api
#   production: https://<your-service>.onrender.com/api
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Canonical site URL (certificate QR codes and share links).
#   production: https://<your-project>.vercel.app or your custom domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js secret. Generate with:
#   npx auth secret        or
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"

# Required behind Vercel's proxy.
AUTH_TRUST_HOST="true"

# Optional locally. On Vercel, AUTH_URL is not needed (it is derived from the request).
# AUTH_URL="http://localhost:3000"

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=""

# Video calls (WebRTC). TURN credentials now come from the backend
# (GET /api/calls/ice-servers, see backend/.env.example). These static values
# are only a last resort used when that request fails; leave them empty.
# NEXT_PUBLIC_TURN_URL="turn:turn.example.com:3478,turns:turn.example.com:5349"
# NEXT_PUBLIC_TURN_USERNAME=""
# NEXT_PUBLIC_TURN_CREDENTIAL=""
